rules_version = '2';

// Cada usuário só pode ler e escrever o próprio documento de progresso.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    // Revisão espaçada do inglês: cartões em blocos (srs) e histórico por mês (srs_log).
    // As regras de `users/{uid}` NÃO valem para subcoleções.
    match /users/{uid}/srs/{bloco} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    match /users/{uid}/srs_log/{mes} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    // Áudios que o aluno anexa às frases (bytes do arquivo + o índice `_idx`).
    match /users/{uid}/audio/{doc} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    // Ranking público: todo logado LÊ o placar; cada um só escreve o próprio.
    match /ranking/{uid} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && request.auth.uid == uid;
    }
    // Config do app (chave do Gemini etc.): logado LÊ; NINGUÉM escreve pelo
    // cliente — só pelo console/REST autenticado do dono do projeto.
    match /config/{doc} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    // nega tudo o mais por padrão
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
