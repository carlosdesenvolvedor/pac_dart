rules_version = '2';

// Cada usuário só pode ler e escrever o próprio documento de progresso.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    // Revisão espaçada do inglês: cartões em blocos (srs) e histórico por mês (srs_log).
    // As regras de `users/{uid}` NÃO valem para subcoleções.
    match /users/{uid}/srs/{bloco} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    match /users/{uid}/srs_log/{mes} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    // Áudios que o aluno anexa às frases (bytes do arquivo + o índice `_idx`).
    match /users/{uid}/audio/{doc} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    // Textos que o aluno cola ou escreve e viram lições (um documento por texto): seguem a conta em
    // qualquer aparelho.
    match /users/{uid}/textos/{id} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    // Banco de palavras do aluno no inglês ("Minhas palavras": palavras treinadas, adicionadas, editadas;
    // um documento só, `v1`).
    match /users/{uid}/palavras/{doc} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    // Setlists do "Ouvir" (inglês): um documento `v1` com o banco inteiro.
    match /users/{uid}/setlists/{doc} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    // Ranking público: todo logado LÊ o placar; cada um só escreve o próprio.
    match /ranking/{uid} {
      allow read: if request.auth != null;
      allow create, update, delete: if request.auth != null && request.auth.uid == uid;
    }
    // Config do app (chave do Gemini etc.): logado LÊ; NINGUÉM escreve pelo
    // cliente — só pelo console/REST autenticado do dono do projeto.
    match /config/{doc} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    // 🎓 Certificados de conclusão: qualquer um (sem login) LÊ um certificado pelo código — é a página pública
    // de verificação; só o dono LISTA os dele; cada um CRIA só o próprio (código no formato, nota ≥ 80, campos
    // fixos); ninguém ALTERA (set num código existente vira update e é negado); o dono pode APAGAR (excluir conta).
    match /certificados/{codigo} {
      allow get: if true;
      allow list: if request.auth != null && resource.data.uid == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && codigo.matches('^PCL-(A1|A2|B1|B2|C1|DEV)-[A-HJKMNP-Z2-9]{4}-[A-HJKMNP-Z2-9]{4}$')
        && request.resource.data.keys().hasOnly(['versao', 'uid', 'nome', 'nivel', 'nomeDoNivel', 'emitidoEm', 'nota', 'horas', 'licoes'])
        && request.resource.data.nivel is string
        && codigo.matches('^PCL-' + request.resource.data.nivel + '-.*')
        && request.resource.data.nome is string
        && request.resource.data.nome.size() >= 5 && request.resource.data.nome.size() <= 80
        && request.resource.data.nota is int
        && request.resource.data.nota >= 80 && request.resource.data.nota <= 100
        && request.resource.data.horas is int && request.resource.data.licoes is int
        && request.resource.data.emitidoEm is string;
      allow update: if false;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }
    // nega tudo o mais por padrão
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
